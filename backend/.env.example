# Backend Configuration Example

# Database (PostgreSQL Async)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/recruiteai

# Auth
SECRET_KEY=generate_a_secure_random_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Seed User (Default Admin)
SEED_USER_EMAIL=dinesh.tomar@yopmail.com
SEED_USER_PASSWORD=Password@123
SEED_USER_NAME=Dinesh Tomar

# OpenAI API
OPENAI_API_KEY=sk-proj-your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_REALTIME_MODEL=gpt-4o-mini-realtime-preview
OPENAI_REALTIME_VOICE=coral

# Deepgram (STT/TTS)
DEEPGRAM_API_KEY=your-deepgram-api-key
DEEPGRAM_STT_MODEL=nova-2-phonecall
DEEPGRAM_TTS_MODEL=aura-asteria-en

# Sarvam (TTS - Indian accent)
SARVAM_API_KEY=your-sarvam-api-key
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya
SARVAM_TTS_LANGUAGE=en-IN
SARVAM_TTS_SAMPLE_RATE=8000
SARVAM_TTS_CODEC=linear16
SARVAM_TTS_PACE=1.2
SARVAM_TTS_TRANSPORT=websocket
SARVAM_TTS_WEBSOCKET_URL=wss://api.sarvam.ai/text-to-speech/ws
SARVAM_TTS_USE_HTTP_STREAM=true
SARVAM_TTS_FIRST_BYTE_TIMEOUT_SECONDS=2.0
SARVAM_TTS_COMPLETION_TIMEOUT_SECONDS=15.0
PIPELINE_TTS_JITTER_BUFFER_MS=200
PIPELINE_STT_ENDPOINTING_MS=500
PIPELINE_STT_UTTERANCE_END_MS=1000

# Twilio (Voice)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1234567890

# Exotel (Voice - India)
EXOTEL_ACCOUNT_SID=your-exotel-account-sid
EXOTEL_API_KEY=your-exotel-api-key
EXOTEL_API_TOKEN=your-exotel-api-token
EXOTEL_PHONE_NUMBER=your-exotel-phone-number
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_FLOW_URL=http://my.exotel.com/crownstack1/exoml/start_voice/1244328

# Runtime Selection
TELEPHONY_PROVIDER=twilio  # twilio, exotel, mock
VOICE_RUNTIME=openai_realtime  # openai_realtime, deepgram_openai
TTS_PROVIDER=deepgram  # deepgram, sarvam

# Storage
STORAGE_PROVIDER=local  # local or s3
STORAGE_LOCAL_PATH=./uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=

# App / Server
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
PUBLIC_URL=https://your-ngrok-url.ngrok-free.app

# Resume Processing Session Management
RESUME_SESSION_TTL_HOURS=1  # Session cleanup after inactivity (in hours)
RESUME_SESSION_CLEANUP_INTERVAL_MINUTES=5  # How often to run cleanup task
SSE_KEEPALIVE_INTERVAL_SECONDS=15  # SSE keepalive interval
