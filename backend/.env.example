# Backend Configuration Example
# Copy this to .env and fill in your values before running the server.
# Required fields are marked with [REQUIRED].

# --- Database [REQUIRED] ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/recruiteai

# --- Auth [REQUIRED] ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Seed User ---
SEED_USER_EMAIL=admin@example.com
SEED_USER_PASSWORD=ChangeMe123!
SEED_USER_NAME=Admin User

# --- OpenAI [REQUIRED] ---
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_REALTIME_MODEL=gpt-4o-mini-realtime-preview
OPENAI_REALTIME_VOICE=coral

# --- Deepgram (STT/TTS) [REQUIRED if using deepgram runtime] ---
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-2-phonecall
DEEPGRAM_TTS_MODEL=aura-asteria-en

# --- Sarvam (TTS - Indian accent) [REQUIRED if TTS_PROVIDER=sarvam] ---
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya
SARVAM_TTS_LANGUAGE=en-IN
SARVAM_TTS_SAMPLE_RATE=8000
SARVAM_TTS_CODEC=linear16
SARVAM_TTS_PACE=1.2
SARVAM_TTS_TRANSPORT=websocket
SARVAM_TTS_WEBSOCKET_URL=wss://api.sarvam.ai/text-to-speech/ws
SARVAM_TTS_USE_HTTP_STREAM=true
SARVAM_TTS_FIRST_BYTE_TIMEOUT_SECONDS=2.0
SARVAM_TTS_COMPLETION_TIMEOUT_SECONDS=15.0
PIPELINE_TTS_JITTER_BUFFER_MS=200
PIPELINE_STT_ENDPOINTING_MS=700
PIPELINE_STT_UTTERANCE_END_MS=1400
PIPELINE_USER_FRAGMENT_GRACE_MS=900

# --- Twilio [REQUIRED if TELEPHONY_PROVIDER=twilio] ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Exotel [REQUIRED if TELEPHONY_PROVIDER=exotel] ---
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_PHONE_NUMBER=
EXOTEL_SUBDOMAIN=api.exotel.com
# Format: http://my.exotel.com/{account_sid}/exoml/start_voice/{flow_id}
EXOTEL_FLOW_URL=

# --- Runtime Selection ---
TELEPHONY_PROVIDER=exotel   # twilio | exotel | mock
VOICE_RUNTIME=deepgram_openai  # openai_realtime | deepgram_openai
TTS_PROVIDER=deepgram       # deepgram | sarvam

# --- Storage ---
STORAGE_PROVIDER=local      # local | s3
STORAGE_LOCAL_PATH=./uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=

# --- App / Server [REQUIRED in production] ---
BACKEND_PORT=8000
# URL of the frontend app (used for CORS)
FRONTEND_URL=http://localhost:5173
# Publicly reachable URL of this backend (used for webhooks and WebSocket URLs)
# In dev: use your ngrok URL e.g. https://abc123.ngrok-free.app
# In production: your actual domain e.g. https://api.yourdomain.com
PUBLIC_URL=http://localhost:8000

# --- LangSmith (optional, for observability) ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=RecruiteAI
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_TRACING=false

# --- Resume Processing Session Management ---
RESUME_SESSION_TTL_HOURS=1
RESUME_SESSION_CLEANUP_INTERVAL_MINUTES=5
SSE_KEEPALIVE_INTERVAL_SECONDS=15
